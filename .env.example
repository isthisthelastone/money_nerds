# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Existing deployments may use this legacy fallback instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key

# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Use a dedicated mainnet RPC in production for reliable transaction verification.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional external sign-in. Every provider stays unavailable until its flag is
# explicitly enabled and all required secrets are configured. Generate a stable
# secret with `openssl rand -base64 48`; changing it changes external profile IDs.
EXTERNAL_AUTH_SECRET=
EXTERNAL_AUTH_ORIGIN=http://localhost:3000
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false
AUTH_TELEGRAM_ENABLED=false

# Telegram Login Widget credentials from BotFather. Both are server-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
