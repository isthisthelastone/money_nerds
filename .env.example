# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Existing deployments may use this legacy fallback instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key

# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Use a dedicated mainnet RPC in production for reliable transaction verification.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Clerk owns application login; Supabase stores the durable canonical profile
# mapping and public activity. Configure production keys from the linked Clerk
# production instance, never development keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
CLERK_AUTHORIZED_PARTIES=https://www.moneynerds.online,https://moneynerds.online,http://localhost:3000

# Stable server-only HMAC key for pseudonymous public profile IDs. Keep this
# value unchanged after launch; rotating it requires an explicit data migration.
PROFILE_IDENTITY_SECRET=

# Public service-funding destinations. These are addresses, never private keys.
# Configure each independently so the Support Money Nerds dialog only advertises
# routes that are actually owned and monitored by the service.
SOLANA_PUBLIC_WALLET=
USDC_SOLANA_PUBLIC_WALLET=
USDT_SOLANA_PUBLIC_WALLET=
ETHEREUM_PUBLIC_WALLET=
USDT_ERC_PUBLIC_WALLET=
BITCOIN_PUBLIC_WALLET=
TRON_PUBLIC_WALLET=
USDT_TRC_PUBLIC_WALLET=
TON_PUBLIC_WALLET=
INJECTIVE_PUBLIC_WALLET=

# Optional server-side verifier endpoints/keys. Public fallbacks are used when
# omitted, but dedicated endpoints are recommended to avoid production limits.
ETHEREUM_RPC_URL=
BITCOIN_API_URL=https://mempool.space/api
TRON_RPC_URL=https://api.trongrid.io
TRON_PRO_API_KEY=
TONCENTER_API_URL=https://toncenter.com/api/v3
TONCENTER_API_KEY=
INJECTIVE_LCD_URL=https://sentry.lcd.injective.network

# Telegram's signed widget bridges into a one-use 60-second Clerk sign-in ticket.
# EXTERNAL_AUTH_SECRET signs the short-lived Telegram transaction cookie.
EXTERNAL_AUTH_SECRET=
EXTERNAL_AUTH_ORIGIN=http://localhost:3000
AUTH_TELEGRAM_ENABLED=true

# Telegram Login Widget credentials from BotFather. Both are server-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
